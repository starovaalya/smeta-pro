// ============================================================
// STATE
// ============================================================
let currentEstimateId = null;
let catalogPickerTargetSectionId = null;
let importPreviewItems = [];

// ============================================================
// UTILS
// ============================================================
function fmt(n) {
  return Number(n || 0).toLocaleString('ru-RU', {minimumFractionDigits:2, maximumFractionDigits:2});
}
function num(v) { return parseFloat(v) || 0; }
function uid() { return Date.now() + Math.random(); }
function notify(msg, type='success') {
  const el = document.getElementById('notification');
  el.textContent = (type==='success'?'✓ ':'⚠ ') + msg;
  el.style.background = type==='success' ? 'var(--success)' : 'var(--warning)';
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2800);
}

// ============================================================
// NAVIGATION
// ============================================================
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  const navMap = {estimates:0, catalog:1, import:2};
  document.querySelectorAll('.nav-item')[navMap[name]]?.classList.add('active');
  if (name === 'estimates') renderEstimatesList();
  if (name === 'catalog') renderCatalog();
  if (name === 'import') resetImport();
}

// ============================================================
// MODAL
// ============================================================
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
window.addEventListener('click', e => {
  if (e.target.classList.contains('modal-overlay')) {
    e.target.classList.remove('open');
  }
});

// ============================================================
// ESTIMATES LIST
// ============================================================
function renderEstimatesList() {
  const grid = document.getElementById('estimates-grid');
  const count = document.getElementById('estimates-count');
  const estimates = db.estimates;
  count.textContent = estimates.length === 0 ? 'Нет смет' : `Всего смет: ${estimates.length}`;
  if (estimates.length === 0) {
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <p>Нет смет. Создайте первую!</p>
    </div>`;
    return;
  }
  grid.innerHTML = estimates.map(e => {
    const totals = calcEstimateTotals(e);
    const statusMap = {draft:['badge-orange','Черновик'], sent:['badge-blue','Отправлена'], approved:['badge-green','Согласована']};
    const [cls, label] = statusMap[e.status] || ['badge-orange','Черновик'];
    return `<div class="estimate-card" onclick="openEstimate(${e.id})">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
        <div class="estimate-card-title">${e.title || 'Без названия'}</div>
        <span class="badge ${cls}">${label}</span>
      </div>
      <div class="estimate-card-meta">
        ${e.number ? `<span>📄 Смета №${e.number}</span>` : ''}
        ${e.client ? `<span>👤 ${e.client}</span>` : ''}
        <span>📅 ${e.date || 'Дата не указана'}</span>
      </div>
      <div class="estimate-card-total">
        <div>
          <div style="font-size:11px;color:var(--muted)">Итого к оплате</div>
          <div class="estimate-card-amount">${fmt(totals.grandTotal)} руб.</div>
        </div>
        <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteEstimate(${e.id})">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>`;
  }).join('');
}

function openNewEstimateModal() {
  const today = new Date().toISOString().slice(0,10);
  document.getElementById('new-number').value = String(db.nextEstimateId).padStart(3,'0');
  document.getElementById('new-date').value = today;
  document.getElementById('new-title').value = '';
  document.getElementById('new-client').value = '';
  document.getElementById('new-discount').value = '0';
  document.getElementById('new-vat').value = '0';
  document.getElementById('new-status').value = 'draft';
  document.getElementById('new-notes').value = '';
  openModal('modal-new-estimate');
}

function createEstimate() {
  const title = document.getElementById('new-title').value.trim();
  if (!title) { alert('Укажите наименование объекта'); return; }
  const est = {
    id: db.nextEstimateId++,
    number: document.getElementById('new-number').value.trim(),
    title,
    client: document.getElementById('new-client').value.trim(),
    date: document.getElementById('new-date').value,
    discountPercent: num(document.getElementById('new-discount').value),
    vatPercent: num(document.getElementById('new-vat').value),
    status: document.getElementById('new-status').value,
    notes: document.getElementById('new-notes').value.trim(),
    sections: [],
    items: []
  };
  db.estimates.unshift(est);
  saveDB();
  closeModal('modal-new-estimate');
  openEstimate(est.id);
  notify('Смета создана');
}

function deleteEstimate(id) {
  if (!confirm('Удалить смету? Это действие нельзя отменить.')) return;
  db.estimates = db.estimates.filter(e => e.id !== id);
  saveDB();
  renderEstimatesList();
  notify('Смета удалена');
}

// ============================================================
// ESTIMATE EDITOR
// ============================================================
function openEstimate(id) {
  currentEstimateId = id;
  showPage('editor');
  renderEditor();
}

function getEstimate() {
  return db.estimates.find(e => e.id === currentEstimateId);
}

function renderEditor() {
  const est = getEstimate();
  if (!est) return;
  document.getElementById('editor-title').textContent =
    (est.number ? `Смета №${est.number} — ` : '') + est.title;
  const metaParts = [];
  if (est.client) metaParts.push(`👤 ${est.client}`);
  if (est.date) metaParts.push(`📅 ${est.date}`);
  if (est.discountPercent > 0) metaParts.push(`<span class="badge badge-orange">Скидка ${est.discountPercent}%</span>`);
  if (est.vatPercent > 0) metaParts.push(`<span class="badge badge-blue">НДС ${est.vatPercent}%</span>`);
  document.getElementById('editor-meta').innerHTML = metaParts.join(' ');
  renderTable();
  renderTotals();
}

function renderTable() {
  const est = getEstimate();
  const tbody = document.getElementById('estimate-tbody');
  let html = '';
  let globalIdx = 0;

  est.sections.forEach(section => {
    const secTotal = section.items.reduce((s, it) => s + calcItemTotal(it), 0);
    html += `<tr class="section-row">
      <td></td>
      <td colspan="7">
        <input class="table-input" style="color:white;font-weight:700" value="${esc(section.name)}"
          onchange="updateSectionName(${section.id}, this.value)">
      </td>
      <td class="computed" style="color:#93c5fd">${fmt(secTotal)}</td>
      <td>
        <div style="display:flex;gap:4px;justify-content:flex-end">
          <button class="btn btn-sm" style="padding:2px 6px;font-size:11px;background:rgba(255,255,255,0.15);color:white;border:1px solid rgba(255,255,255,0.3)" 
            onclick="openCatalogModal(${section.id})" title="Из справочника">+справ.</button>
          <button class="btn btn-sm" style="padding:2px 6px;font-size:11px;background:rgba(255,255,255,0.15);color:white;border:1px solid rgba(255,255,255,0.3)" 
            onclick="addManualItem(${section.id})" title="Вручную">+ручная</button>
        </div>
      </td>
      <td>
        <button onclick="deleteSection(${section.id})" style="background:none;border:none;cursor:pointer;color:#fca5a5" title="Удалить раздел">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </td>
    </tr>`;
    section.items.forEach((item, i) => {
      globalIdx++;
      html += itemRowHTML(item, globalIdx, i);
    });
  });

  est.items.forEach((item, i) => {
    globalIdx++;
    html += itemRowHTML(item, globalIdx, i);
  });

  if (globalIdx === 0 && est.sections.length === 0) {
    html = `<tr><td colspan="11" style="text-align:center;padding:40px;color:var(--muted)">
      Смета пуста. Добавьте раздел или позицию.
    </td></tr>`;
  }

  tbody.innerHTML = html;
}

function itemRowHTML(item, rowNum, i) {
  const t = calcItemTotal(item);
  const alt = i % 2 === 1 ? 'alt' : '';
  return `<tr class="item-row ${alt}" data-item-id="${item.id}">
    <td style="text-align:center;color:var(--muted);font-size:12px">${rowNum}</td>
    <td><input class="table-input" value="${esc(item.name)}" onchange="updateItemField(${item.id},'name',this.value)" style="font-weight:500"></td>
    <td><input class="table-input" value="${esc(item.unit)}" onchange="updateItemField(${item.id},'unit',this.value)" style="text-align:center"></td>
    <td><input class="table-input num" type="number" step="any" min="0" value="${item.qty}" onchange="updateItemField(${item.id},'qty',this.value)" oninput="updateItemField(${item.id},'qty',this.value)"></td>
    <td><input class="table-input num" type="number" step="any" min="0" value="${item.matPrice}" onchange="updateItemField(${item.id},'matPrice',this.value)" oninput="updateItemField(${item.id},'matPrice',this.value)"></td>
    <td><input class="table-input num" type="number" step="any" min="0" value="${item.labPrice}" onchange="updateItemField(${item.id},'labPrice',this.value)" oninput="updateItemField(${item.id},'labPrice',this.value)"></td>
    <td class="computed" style="color:var(--muted)">${fmt(t.matTotal)}</td>
    <td class="computed" style="color:var(--muted)">${fmt(t.labTotal)}</td>
    <td class="computed" style="color:var(--primary);font-weight:700">${fmt(t.total)}</td>
    <td><input class="table-input" value="${esc(item.notes||'')}" onchange="updateItemField(${item.id},'notes',this.value)" placeholder="Примечание..." style="font-size:12px;color:var(--muted)"></td>
    <td>
      <button onclick="deleteItem(${item.id})" style="background:none;border:none;cursor:pointer;color:#d1d5db" title="Удалить" onmouseover="this.style.color='var(--danger)'" onmouseout="this.style.color='#d1d5db'">
        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
    </td>
  </tr>`;
}

function esc(s) { return String(s||'').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }

function calcItemTotal(item) {
  const qty = num(item.qty);
  const matTotal = qty * num(item.matPrice);
  const labTotal = qty * num(item.labPrice);
  return { matTotal, labTotal, total: matTotal + labTotal };
}

function calcEstimateTotals(est) {
  let matTotal = 0, labTotal = 0;
  const allItems = [...(est.items||[]), ...(est.sections||[]).flatMap(s => s.items||[])];
  allItems.forEach(it => {
    const t = calcItemTotal(it);
    matTotal += t.matTotal;
    labTotal += t.labTotal;
  });
  const subtotal = matTotal + labTotal;
  const discountAmount = subtotal * (num(est.discountPercent) / 100);
  const afterDiscount = subtotal - discountAmount;
  const vatAmount = afterDiscount * (num(est.vatPercent) / 100);
  const grandTotal = afterDiscount + vatAmount;
  return { matTotal, labTotal, subtotal, discountAmount, afterDiscount, vatAmount, grandTotal };
}

function renderTotals() {
  const est = getEstimate();
  const t = calcEstimateTotals(est);
  let html = `<div class="totals-title">Итоги сметы</div>
    <div class="totals-row"><span class="totals-label">Материалы:</span><span class="totals-value">${fmt(t.matTotal)} руб.</span></div>
    <div class="totals-row"><span class="totals-label">Работы:</span><span class="totals-value">${fmt(t.labTotal)} руб.</span></div>
    <div class="totals-row separator"><span class="totals-label" style="font-weight:700">Подытог:</span><span class="totals-value">${fmt(t.subtotal)} руб.</span></div>`;
  if (t.discountAmount > 0) {
    html += `<div class="totals-row"><span class="totals-label">Скидка (${est.discountPercent}%):</span><span class="totals-value red">−${fmt(t.discountAmount)} руб.</span></div>
    <div class="totals-row"><span class="totals-label">После скидки:</span><span class="totals-value">${fmt(t.afterDiscount)} руб.</span></div>`;
  }
  if (t.vatAmount > 0) {
    html += `<div class="totals-row"><span class="totals-label">НДС (${est.vatPercent}%):</span><span class="totals-value">${fmt(t.vatAmount)} руб.</span></div>`;
  }
  html += `<div class="totals-row grand"><span class="totals-label" style="font-weight:800;color:var(--primary)">ИТОГО К ОПЛАТЕ:</span><span class="totals-value accent">${fmt(t.grandTotal)} руб.</span></div>`;
  document.getElementById('totals-panel').innerHTML = html;
}

