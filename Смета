// ============================================================
// IMPORT KP
// ============================================================
function resetImport() {
  document.getElementById('import-preview').style.display = 'none';
  document.getElementById('file-input').value = '';
  importPreviewItems = [];
}

function onDragOver(e) {
  e.preventDefault();
  document.getElementById('drop-zone').classList.add('dragover');
}
function onDragLeave(e) {
  document.getElementById('drop-zone').classList.remove('dragover');
}
function onDrop(e) {
  e.preventDefault();
  document.getElementById('drop-zone').classList.remove('dragover');
  const file = e.dataTransfer.files[0];
  if (file) processImportFile(file);
}
function handleFileInput(e) {
  const file = e.target.files[0];
  if (file) processImportFile(file);
}

function processImportFile(file) {
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const wb = XLSX.read(e.target.result, {type:'binary'});
      const allItems = [];
      
      wb.SheetNames.forEach(sheetName => {
        const ws = wb.Sheets[sheetName];
        const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
        
        let currentCategory = 'Импортированные';
        
        rows.forEach(row => {
          if (!row || row.length < 2) return;
          
          // Detect section headers (rows with text in col 1, no numbers in numeric cols)
          const col0 = String(row[0]||'').trim();
          const col1 = String(row[1]||'').trim();
          
          // Skip header rows
          if (col1.toLowerCase().includes('наименование') || col0 === '№' || col0 === 'No') return;
          
          // Detect category rows (no numeric data, has text)
          const hasNumericData = row.slice(3,9).some(v => {
            const n = parseFloat(String(v).replace(/\s/g,'').replace(',','.'));
            return !isNaN(n) && n > 0;
          });
          
          if (col1 && !hasNumericData && !col0) {
            currentCategory = col1;
            return;
          }
          if (col1 && !hasNumericData && (isNaN(parseFloat(col0)) || col0 === '')) {
            if (col1.length > 3 && col1.length < 60) {
              currentCategory = col1;
            }
            return;
          }
          
          // Try to parse item row
          const name = col1 || String(row[2]||'').trim();
          if (!name || name.length < 3) return;
          
          // Parse numeric values from different possible positions
          const parseNum = (v) => {
            const s = String(v||'').replace(/\s/g,'').replace(',','.');
            const n = parseFloat(s);
            return isNaN(n) ? 0 : n;
          };
          
          // Heuristic: unit in col 2, qty in col 3, matPrice in col 4, labPrice in col 5
          const unit = String(row[2]||'шт.').trim() || 'шт.';
          const matPrice = parseNum(row[4]);
          const labPrice = parseNum(row[5]);
          
          if ((matPrice > 0 || labPrice > 0) && name.length > 2) {
            allItems.push({
              name: name.substring(0, 100),
              category: currentCategory,
              unit: unit.substring(0, 20),
              materialPrice: matPrice,
              laborPrice: labPrice,
            });
          }
        });
      });

      // Deduplicate: filter items already in catalog
      const existingNames = new Set(db.catalog.map(i => i.name.toLowerCase().trim()));
      const newItems = [];
      const dupItems = [];
      
      allItems.forEach(item => {
        if (existingNames.has(item.name.toLowerCase().trim())) {
          dupItems.push(item);
        } else {
          newItems.push(item);
          existingNames.add(item.name.toLowerCase().trim());
        }
      });

      // Remove duplicates within imported list itself
      const uniqueNew = [];
      const seen = new Set();
      newItems.forEach(item => {
        const key = item.name.toLowerCase().trim();
        if (!seen.has(key)) { seen.add(key); uniqueNew.push(item); }
      });

      importPreviewItems = uniqueNew.map((item, i) => ({...item, _selected: true, _idx: i}));

      showImportPreview(allItems.length, uniqueNew.length, dupItems.length);
    } catch(err) {
      alert('Ошибка чтения файла: ' + err.message);
    }
  };
  reader.readAsBinaryString(file);
}

function showImportPreview(total, newCount, dupCount) {
  document.getElementById('import-preview').style.display = 'block';
  document.getElementById('import-stats').innerHTML = `
    <div class="stat-card">
      <div class="stat-value" style="color:var(--accent)">${total}</div>
      <div class="stat-label">Найдено всего</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--success)">${newCount}</div>
      <div class="stat-label">Новых позиций</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--warning)">${dupCount}</div>
      <div class="stat-label">Пропущено (дубли)</div>
    </div>
  `;
  renderImportList();
}

function renderImportList() {
  const list = document.getElementById('import-list');
  if (importPreviewItems.length === 0) {
    list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Нет новых позиций для импорта (все уже есть в справочнике)</div>';
    return;
  }
  
  const byCategory = {};
  importPreviewItems.forEach(item => {
    const cat = item.category || 'Прочее';
    if (!byCategory[cat]) byCategory[cat] = [];
    byCategory[cat].push(item);
  });

  list.innerHTML = Object.entries(byCategory).map(([cat, items]) => `
    <div class="catalog-category">${cat}</div>
    ${items.map(item => `
      <div class="catalog-item" style="padding:8px 10px">
        <input type="checkbox" id="imp-${item._idx}" ${item._selected?'checked':''} 
          onchange="toggleImportItem(${item._idx}, this.checked)" style="margin-right:8px;width:16px;height:16px">
        <div style="flex:1">
          <div class="catalog-item-name">${item.name}</div>
          <div class="catalog-item-prices">
            ${item.unit} 
            ${item.materialPrice > 0 ? `| Мат: ${fmt(item.materialPrice)} руб.` : ''}
            ${item.laborPrice > 0 ? `| Раб: ${fmt(item.laborPrice)} руб.` : ''}
          </div>
        </div>
      </div>
    `).join('')}
  `).join('');
}

function toggleImportItem(idx, checked) {
  const item = importPreviewItems.find(i => i._idx === idx);
  if (item) item._selected = checked;
}

function selectAllImport() {
  importPreviewItems.forEach(i => i._selected = true);
  renderImportList();
}

function doImport() {
  const selected = importPreviewItems.filter(i => i._selected);
  if (selected.length === 0) { notify('Выберите позиции для импорта', 'warning'); return; }
  
  selected.forEach(item => {
    db.catalog.push({
      id: db.nextCatalogId++,
      name: item.name,
      category: item.category,
      unit: item.unit,
      materialPrice: item.materialPrice,
      laborPrice: item.laborPrice,
    });
  });
  saveDB();
  notify(`Импортировано ${selected.length} позиций`);
  resetImport();
  showPage('catalog');
}

