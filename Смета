function deleteSection(id) {
  if (!confirm('Удалить раздел и все его позиции?')) return;
  const est = getEstimate();
  est.sections = est.sections.filter(s => s.id !== id);
  saveDB();
  renderTable();
  renderTotals();
  notify('Раздел удалён');
}

function updateSectionName(id, name) {
  const est = getEstimate();
  const sec = est.sections.find(s => s.id === id);
  if (sec) { sec.name = name; saveDB(); }
}

function addManualItem(sectionId) {
  const est = getEstimate();
  const item = {
    id: db.nextItemId++,
    name: 'Новая позиция',
    unit: 'шт.',
    qty: 1,
    matPrice: 0,
    labPrice: 0,
    notes: ''
  };
  if (sectionId !== null) {
    const sec = est.sections.find(s => s.id === sectionId);
    if (sec) sec.items.push(item);
  } else {
    est.items.push(item);
  }
  saveDB();
  renderTable();
  renderTotals();
}

function updateItemField(itemId, field, value) {
  const est = getEstimate();
  let item = est.items.find(i => i.id === itemId);
  if (!item) {
    for (const sec of est.sections) {
      item = sec.items.find(i => i.id === itemId);
      if (item) break;
    }
  }
  if (!item) return;
  item[field] = (['qty','matPrice','labPrice'].includes(field)) ? num(value) : value;
  saveDB();
  // Update computed cells only
  const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
  if (row) {
    const t = calcItemTotal(item);
    const tds = row.querySelectorAll('.computed');
    if (tds[0]) tds[0].textContent = fmt(t.matTotal);
    if (tds[1]) tds[1].textContent = fmt(t.labTotal);
    if (tds[2]) tds[2].textContent = fmt(t.total);
  }
  renderTotals();
  // Also update section totals
  updateSectionTotals();
}

function updateSectionTotals() {
  const est = getEstimate();
  est.sections.forEach(sec => {
    const total = sec.items.reduce((s,it) => s + calcItemTotal(it).total, 0);
    const rows = document.querySelectorAll('.section-row');
    rows.forEach(row => {
      const btn = row.querySelector('button[onclick^="deleteSection(' + sec.id + ')"]');
      if (btn) {
        const computedCells = row.querySelectorAll('.computed');
        if (computedCells[0]) computedCells[0].textContent = fmt(total);
      }
    });
  });
}

function deleteItem(itemId) {
  const est = getEstimate();
  est.items = est.items.filter(i => i.id !== itemId);
  est.sections.forEach(sec => {
    sec.items = sec.items.filter(i => i.id !== itemId);
  });
  saveDB();
  renderTable();
  renderTotals();
}

