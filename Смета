function exportExcel() {
  const est = getEstimate();
  const wb = XLSX.utils.book_new();
  const rows = [];

  // Header
  rows.push([`СМЕТА №${est.number || ''}`, '', `от ${est.date || ''}`, '', '', '', '', '', '']);
  if (est.client) rows.push([`Заказчик: ${est.client}`]);
  rows.push([]);
  rows.push(['№', 'Наименование работ', 'Ед.из.', 'Кол-во', 'Мат. цена', 'Раб. цена', 'Мат. итого', 'Раб. итого', 'Всего, руб.', 'Примечание']);

  let rowNum = 0;

  // Sections
  est.sections.forEach(sec => {
    rows.push(['', sec.name, '', '', '', '', '', '', '', '']);
    sec.items.forEach(item => {
      rowNum++;
      const t = calcItemTotal(item);
      rows.push([rowNum, item.name, item.unit, item.qty, item.matPrice, item.labPrice, t.matTotal, t.labTotal, t.total, item.notes||'']);
    });
    const secTotal = sec.items.reduce((s,i) => s + calcItemTotal(i).total, 0);
    rows.push(['', `Итого по разделу "${sec.name}":`, '', '', '', '', '', '', secTotal, '']);
    rows.push([]);
  });

  est.items.forEach(item => {
    rowNum++;
    const t = calcItemTotal(item);
    rows.push([rowNum, item.name, item.unit, item.qty, item.matPrice, item.labPrice, t.matTotal, t.labTotal, t.total, item.notes||'']);
  });

  // Totals
  const tot = calcEstimateTotals(est);
  rows.push([]);
  rows.push(['', 'Материалы:', '', '', '', '', '', '', tot.matTotal, '']);
  rows.push(['', 'Работы:', '', '', '', '', '', '', tot.labTotal, '']);
  rows.push(['', 'Подытог:', '', '', '', '', '', '', tot.subtotal, '']);
  if (tot.discountAmount > 0) {
    rows.push(['', `Скидка (${est.discountPercent}%):`, '', '', '', '', '', '', -tot.discountAmount, '']);
    rows.push(['', 'После скидки:', '', '', '', '', '', '', tot.afterDiscount, '']);
  }
  if (tot.vatAmount > 0) {
    rows.push(['', `НДС (${est.vatPercent}%):`, '', '', '', '', '', '', tot.vatAmount, '']);
  }
  rows.push(['', 'ИТОГО К ОПЛАТЕ:', '', '', '', '', '', '', tot.grandTotal, '']);

  if (est.notes) rows.push(['', `Примечания: ${est.notes}`]);

  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [
    {wch:5},{wch:45},{wch:8},{wch:8},{wch:12},{wch:12},{wch:14},{wch:14},{wch:14},{wch:20}
  ];
  XLSX.utils.book_append_sheet(wb, ws, 'Смета');
  XLSX.writeFile(wb, `Смета_${est.number || est.id}_${est.title}.xlsx`);
  notify('Excel файл скачан');
}

